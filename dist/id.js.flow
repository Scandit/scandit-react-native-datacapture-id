}
declare interface PrivateDrivingLicenseCategory {
  fromJSON(
    json: DrivingLicenseCategoryJSON | null
  ): DrivingLicenseCategory | null;
}
/**
 * @since 8.0.0
 */
declare class DrivingLicenseDetails {
  /**
   * Additional information from driver licenses such as vehicle categories.
