   */
  relationshipDescription: string | null;

  /**
   * The restriction code.
   * @since 7.0.0
   */
  restrictionsCode: string | null;

  /**
   * The card security code.
   * @since 7.0.0
   */
  securityCode: string | null;

  /**
   * The service code.
   * @since 7.0.0
   */
  serviceCode: string | null;

  /**
